# Append TDX terminal session.
if [ -f "$HOME/.bashrc" ]; then . "$HOME/.bashrc"; fi
export PATH="$HOME/.local/bin:$PATH"
unalias ls 2>/dev/null || true
ls() {
  if [ "$#" -eq 1 ] && [ "$1" = '-rr' ]; then
    "$HOME/.local/bin/-rr" --list
  else
    command ls "$@"
  fi
}
append-help() {
  printf '\n\033[1;35mAPPEND TDX\033[0m\n'
  printf '  ls -rr                  List installed GUI apps\n'
  printf '  -rr APP NAME            Launch GUI app\n'
  printf '  u -rr APP NAME          Preview and confirm app uninstall\n'
  printf '  append-capture gui      Capture/select/annotate screenshot\n'
  printf '  append-capture full     Save entire screen\n'
  printf '  append-capture window   Save focused window\n'
  printf '  PrtSc                   Open Append Capture\n'
  printf '  Shift+PrtSc             Select screenshot area\n'
  printf '  Alt+PrtSc               Capture active window\n'
  printf '  Ctrl+PrtSc              Capture full screen\n'
  printf '  append-tabs              List open application windows (legacy helper)\n'
  printf '  /settings               Open text-based system settings\n'
  printf '  /wifi                   Scan and connect to Wi-Fi\n'
  printf '  /taskbar add            Enable optional taskbar\n'
  printf '  /taskbar remove         Disable optional taskbar\n'
  printf '  update tdx              Install newest Append TDX version\n'
  printf '  exit                    End Append TDX session\n\n'
}
append-tabs() { "$HOME/.local/bin/append-windows" list; }
append-switch() { "$HOME/.local/bin/append-windows" switch "$@"; }
append_prompt() { "$HOME/.local/bin/append-windows" compact 2>/dev/null || true; }
PROMPT_COMMAND="append_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
export PS1='\[\e[1;35m\]append\[\e[0m\]:\[\e[1;37m\]\w\[\e[0m\] $ '
clear
append-help

# Terminal-first Append TDX commands; bash functions make /settings and /wifi work.
function /settings() { "$HOME/.local/bin/append-control" settings "$@"; }
function /wifi() { "$HOME/.local/bin/append-control" wifi "$@"; }
function /volume() { "$HOME/.local/bin/append-control" volume "$@"; }
function /taskbar() { "$HOME/.local/bin/append-control" taskbar "$@"; }
function /brightness() { "$HOME/.local/bin/append-control" brightness "$@"; }
function /bluetooth() { "$HOME/.local/bin/append-control" bluetooth "$@"; }
function /screenshot() { "$HOME/.local/bin/append-capture" "${1:-gui}"; }
function /help() {
  printf '\nAppend TDX commands:\n'
  printf ' /settings    interactive terminal settings\n'
  printf ' /wifi        scan and connect with NetworkManager\n'
  printf ' /volume      status, up, down, mute or 0-100\n'
  printf ' /brightness  status, up, down or 5-100\n'
  printf ' /bluetooth   interactive Bluetooth manager\n'
  printf ' /taskbar add|remove|status\n'
  printf ' /screenshot  gui|full|window\n'
}

# Update Append TDX by simply typing: update tdx
update() {
  if [ "$#" -eq 1 ] && [ "$1" = "tdx" ]; then
    "$HOME/.local/bin/append-tdx-update"
  else
    printf 'Usage: update tdx\n' >&2
    return 2
  fi
}

printf 'Tip: type update tdx to check for and install TDX updates.\n'
