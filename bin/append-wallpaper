#!/usr/bin/env python3
"""Configure an image wallpaper for the Append TDX desktop surface."""
from pathlib import Path
import sys
from PIL import Image

config = Path.home() / ".config/append-tdx"
config.mkdir(parents=True, exist_ok=True)
setting = config / "wallpaper"
args = sys.argv[1:]
if not args or args[0] == "status":
    print("Wallpaper:", setting.read_text().strip() if setting.exists() else "default purple")
elif args[0] == "clear":
    setting.unlink(missing_ok=True)
    print("Wallpaper cleared.")
elif args[0] == "set" and len(args) >= 2:
    target = Path(" ".join(args[1:])).expanduser().resolve()
    if not target.is_file():
        sys.exit("Image not found.")
    try:
        with Image.open(target) as img:
            img.verify()
    except Exception:
        sys.exit("Unsupported or invalid image.")
    setting.write_text(str(target) + "\n")
    print("Wallpaper selected:", target)
else:
    sys.exit("Usage: /background set /path/to/image.png | /background clear | /background status")
