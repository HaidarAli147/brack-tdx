#!/usr/bin/env python3
"""Create an Append TDX-only Openbox configuration, leaving other desktops intact."""
from pathlib import Path
import shutil
import xml.etree.ElementTree as ET

config_dir = Path.home() / ".config" / "append-tdx"
config_dir.mkdir(parents=True, exist_ok=True)
dest = config_dir / "openbox.xml"
source = Path("/etc/xdg/openbox/rc.xml")
if not source.exists():
    raise SystemExit("Missing Openbox default configuration: /etc/xdg/openbox/rc.xml")
tree = ET.parse(source)
root = tree.getroot()
namespace = root.tag.split("}")[0][1:] if root.tag.startswith("{") else ""
if namespace:
    ET.register_namespace("", namespace)
tag = lambda name: f"{{{namespace}}}{name}" if namespace else name
keyboard = root.find(tag("keyboard"))
if keyboard is None:
    keyboard = ET.SubElement(root, tag("keyboard"))
bin_dir = str(Path.home() / '.local/bin')
shortcuts = {
    "Print": "append-capture gui",
    "S-Print": "append-capture area",
    "A-Print": "append-capture window",
    "C-Print": "append-capture full",
    "XF86AudioRaiseVolume": "append-media volume-up",
    "XF86AudioLowerVolume": "append-media volume-down",
    "XF86AudioMute": "append-media volume-mute",
    "XF86AudioMicMute": "append-media mic-mute",
    "XF86MonBrightnessUp": "append-media brightness-up",
    "XF86MonBrightnessDown": "append-media brightness-down",
}
for key, command in shortcuts.items():
    for binding in list(keyboard.findall(tag("keybind"))):
        if binding.get("key") == key:
            keyboard.remove(binding)
    binding = ET.SubElement(keyboard, tag("keybind"), {"key": key})
    action = ET.SubElement(binding, tag("action"), {"name": "Execute"})
    ET.SubElement(action, tag("command")).text = bin_dir + "/" + command
tree.write(dest, encoding="utf-8", xml_declaration=True)
print(f"Append TDX Openbox shortcuts saved to {dest}")
