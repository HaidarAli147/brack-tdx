#!/usr/bin/env bash
set -euo pipefail
export XDG_CURRENT_DESKTOP=APPEND
export XDG_SESSION_DESKTOP=append-tdx
export PATH="$HOME/.local/bin:$PATH"
"$HOME/.local/bin/append-openbox-config"
openbox --sm-disable --config-file "$HOME/.config/append-tdx/openbox.xml" &
wm_pid=$!
cleanup() { kill "$wm_pid" ${bar_pid:-} 2>/dev/null || true; }
trap cleanup EXIT
sleep 1
if [ -f "$HOME/.config/append-tdx/taskbar.enabled" ]; then
  "$HOME/.local/bin/append-control" taskbar add || true
fi
if [ ! -f "$HOME/.config/append-tdx/taskbar.enabled" ]; then
  "$HOME/.local/bin/brack-minibar" &
  bar_pid=$!
fi
kitty --title 'Append TDX Desktop' --override hide_window_decorations=yes \
  --config "$HOME/.config/append-tdx/kitty.conf" \
  --start-as maximized -- bash --rcfile "$HOME/.config/append-tdx/bashrc" -i &
kitty_pid=$!
for n in $(seq 1 60); do
  wid="$(xdotool search --onlyvisible --name '^Append TDX Desktop$' 2>/dev/null | head -n 1 || true)"
  if [ -n "$wid" ]; then
    "$HOME/.local/bin/append-desktop-window" "$wid"
    break
  fi
  sleep 0.25
done
wait "$kitty_pid" || true
