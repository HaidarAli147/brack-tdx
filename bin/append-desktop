#!/usr/bin/env python3
"""Append TDX terminal desktop surface. GTK3/VTE, not an external Kitty window."""
import os
import json
from pathlib import Path
import sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Vte", "2.91")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Vte

HOME = Path.home()
RC = HOME / ".config/append-tdx/bashrc"

# This surface is a desktop-shell component, not a GNOME/Budgie application.
if os.environ.get("APPEND_TDX_SESSION") != "1" or os.environ.get("XDG_CURRENT_DESKTOP") != "APPEND":
    sys.exit("Append TDX is a login session. Log out, select 'Append TDX' in your display manager, and log in. Do not launch append-desktop inside GNOME or Budgie.")

class AppendDesktop(Gtk.Window):
    def __init__(self):
        super().__init__(title="Append TDX Desktop")
        self.set_name("append-desktop")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DESKTOP)
        self.set_keep_below(True)
        self.set_accept_focus(True)
        screen = Gdk.Screen.get_default()
        self.set_default_size(screen.get_width(), screen.get_height())
        self.connect("destroy", Gtk.main_quit)

        theme = {"background": "#210D34", "foreground": "#F3E8FF", "accent": "#9D4EDD"}
        try:
            data = json.loads((HOME / ".config/append-tdx/theme.json").read_text())
            if all(isinstance(data.get(k), str) and len(data[k]) == 7 and data[k][0] == "#" and all(c in "0123456789abcdefABCDEF" for c in data[k][1:]) for k in theme):
                theme = data
        except (OSError, ValueError, TypeError):
            pass
        css = Gtk.CssProvider()
        css.load_from_data((
            "#append-desktop { background: " + theme["background"] + "; }"
            "#append-desktop box { background: " + theme["background"] + "; }"
            "#append-header { color: " + theme["accent"] + "; font: 12px Sans; padding: 10px 20px; }"
        ).encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        overlay = Gtk.Overlay()
        self.add(overlay)
        setting = HOME / ".config/append-tdx/wallpaper"
        has_wallpaper = False
        if setting.is_file():
            path = Path(setting.read_text().strip())
            if path.is_file():
                try:
                    pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), screen.get_width(), screen.get_height(), False)
                    overlay.add(Gtk.Image.new_from_pixbuf(pixbuf))
                    has_wallpaper = True
                except GLib.Error as exc:
                    print("Wallpaper error:", exc, file=sys.stderr)
        if not has_wallpaper:
            overlay.add(Gtk.Box())
        layout = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        if has_wallpaper:
            layout.set_margin_start(20)
            layout.set_margin_end(20)
            layout.set_margin_top(20)
            layout.set_margin_bottom(20)
        overlay.add_overlay(layout)
        header = Gtk.Label(label="APPEND TDX    /settings   /wifi   /taskbar add   update tdx")
        header.set_name("append-header")
        header.set_halign(Gtk.Align.START)
        layout.pack_start(header, False, False, 0)

        terminal = Vte.Terminal()
        self.terminal = terminal
        terminal.set_scrollback_lines(10000)
        bg = Gdk.RGBA()
        bg.parse(theme["background"])
        fg = Gdk.RGBA()
        fg.parse(theme["foreground"])
        terminal.set_color_background(bg)
        terminal.set_color_foreground(fg)
        terminal.set_cursor_blink_mode(Vte.CursorBlinkMode.ON)
        layout.pack_start(terminal, True, True, 0)
        terminal.connect("child-exited", lambda *_: Gtk.main_quit())
        terminal.connect("key-press-event", self.on_terminal_key_press)

        self.show_all()
        # A fullscreen request turns an EWMH desktop surface into a normal
        # fullscreen application in several X11 window managers. Size it
        # to the screen without requesting _NET_WM_STATE_FULLSCREEN.
        self.move(0, 0)
        self.resize(screen.get_width(), screen.get_height())
        terminal.grab_focus()
        GLib.timeout_add(300, self.focus_terminal)

        def child_ready(term, pid, error, *rest):
            if error:
                print("Append TDX terminal failed:", error, file=sys.stderr)
                Gtk.main_quit()
        terminal.spawn_async(
            Vte.PtyFlags.DEFAULT,
            str(HOME),
            ["/bin/bash", "--rcfile", str(RC), "-i"],
            None,
            GLib.SpawnFlags.DEFAULT,
            None,  # child_setup
            None,  # child_setup_data (required by PyGObject on Debian)
            -1,    # timeout
            None,  # cancellable
            child_ready,
        )

    def on_terminal_key_press(self, terminal, event):
        # VTE does not configure app-specific copy/paste accelerators itself.
        # These keys must be consumed before they reach the Bash PTY.
        required = Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK
        if (event.state & required) != required:
            return False
        key = Gdk.keyval_name(event.keyval)
        if key in ("v", "V"):
            terminal.paste_clipboard()
            return True
        if key in ("c", "C"):
            terminal.copy_clipboard()
            return True
        return False

    def focus_terminal(self):
        self.terminal.grab_focus()
        window = self.get_window()
        if window:
            window.focus(Gdk.CURRENT_TIME)
        return False

if __name__ == "__main__":
    AppendDesktop()
    Gtk.main()
