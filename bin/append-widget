#!/usr/bin/env python3
"""Small, nonblocking text-only status widgets for Append TDX tint2."""
import subprocess
import sys
from pathlib import Path

def output(*cmd):
    try:
        return subprocess.run(cmd, text=True, capture_output=True, timeout=2, check=False).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""

kind = sys.argv[1] if len(sys.argv)>1 else ""
click = len(sys.argv)>2 and sys.argv[2]=="click"
if kind=="wifi":
    if click:
        try:
            subprocess.Popen(["nm-connection-editor"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
    else:
        status=output("nmcli","-t","-f","ACTIVE,SSID","device","wifi")
        ssid=next((line[4:] for line in status.splitlines() if line.startswith("yes:")), "")
        print("[wifi " + (ssid[:14] if ssid else "offline") + "]")
elif kind=="battery":
    if not click:
        batteries=list(Path("/sys/class/power_supply").glob("BAT*/capacity"))
        try:
            value=batteries[0].read_text().strip() + "%" if batteries else "n/a"
        except OSError:
            value="n/a"
        print("[bat " + value + "]")
elif kind=="notifications":
    if click:
        output("dunstctl","history-pop")
    else:
        count=output("dunstctl","count","history")
        print("[notice " + (count if count.isdigit() else "0") + "]")
