#!/usr/bin/env python3
"""Generate a dedicated Append TDX tint2 panel theme; does not affect other desktops."""
from pathlib import Path
import json
import re
out = Path.home() / ".config/append-tdx/tint2rc"
out.parent.mkdir(parents=True, exist_ok=True)
theme = {"background": "#210D34", "foreground": "#F3E8FF", "accent": "#9D4EDD"}
try:
    obj = json.loads((out.parent / "theme.json").read_text())
    if all(isinstance(obj.get(k), str) and re.fullmatch(r"#[0-9a-fA-F]{6}", obj[k]) for k in theme):
        theme = obj
except (OSError, ValueError, TypeError):
    pass
template = """# Append TDX text-first terminal panel (applications | clock)
rounded = 0
border_width = 1
background_color = #210D34 96
border_color = #9555D4 90
background_id = 1

rounded = 0
border_width = 0
background_color = #7434A8 90
background_id = 2

panel_items = TCE
panel_monitor = all
panel_position = bottom center horizontal
panel_size = 100% 32
panel_margin = 0 0
panel_padding = 12 2 8
panel_background_id = 1
panel_dock = 1
strut_policy = follow_size
panel_layer = normal
panel_shrink = 0
wm_menu = 0

taskbar_mode = multi_desktop
taskbar_padding = 5 4 5
taskbar_background_id = 0
taskbar_active_background_id = 2
taskbar_name = 0
taskbar_hide_if_empty = 0

task_icon = 0
task_text = 1
task_maximum_size = 240 28
task_centered = 0
task_padding = 12 1 12
task_background_id = 0
task_active_background_id = 2
task_font = Monospace 10
task_font_color = #F5E9FF 100
task_active_font_color = #FFFFFF 100
task_tooltip = 1

time1_format = [%H:%M]
time1_font = Monospace Bold 10
clock_font_color = #F5E9FF 100
clock_padding = 12 4
clock_background_id = 0
tooltip_padding = 4 4
tooltip_background_color = #210D34 95
tooltip_font_color = #F5E9FF 100
"""
# Optional text widgets, disabled unless explicitly enabled in /widgets.
widgets_file = out.parent / "widgets"
enabled = set(widgets_file.read_text().split()) if widgets_file.exists() else set()
supported = {"wifi", "battery", "notifications"}
enabled &= supported
widgets = []
for item in ("wifi", "battery", "notifications"):
    if item not in enabled:
        continue
    script = Path.home() / ".local/bin/append-widget"
    widgets.append("\\n".join([
        "execp = new",
        "execp_command = " + str(script) + " " + item,
        "execp_interval = 10" if item != "notifications" else "execp_interval = 5",
        "execp_font = Monospace 10",
        "execp_font_color = " + theme["foreground"] + " 100",
        "execp_padding = 8 0",
        "execp_background_id = 0",
        "execp_centered = 1",
        "execp_markup = 0",
        "execp_tooltip = " + item,
        "execp_lclick_command = " + str(script) + " " + item + " click",
        "",
    ]))
if not widgets:
    template = template.replace("panel_items = TCE", "panel_items = TC")
else:
    template += "\\n".join(widgets) + "\\n"
template = template.replace("#210D34", theme["background"]).replace("#9555D4", theme["accent"]).replace("#7434A8", theme["accent"]).replace("#F5E9FF", theme["foreground"]).replace("#FFFFFF", theme["foreground"])
out.write_text(template, encoding="utf-8")
print(out)
